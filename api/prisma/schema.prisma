generator client {
  provider = "prisma-client-js"
 // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//Create.Database.Schemas
//User.model
// Roles dinámicos: el SUPERADMIN los crea desde el panel y cada uno lleva sus permisos
model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions String[] @default([])

  //Relations
  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model User {
  id        String      @id @default(uuid())
  email     String   @unique
  password  String
  firstName      String?
  lastName       String?
  phone          String?
  refreshToken String?
  // Recuperación de contraseña: código (OTP) de 6 dígitos como texto (puede empezar con 0), su vencimiento y los intentos fallidos
  resetPasswordOtp String?
  resetPasswordAttempts Int @default(0)
  resetPasswordExpires DateTime?
  // Bloqueo de login: intentos fallidos consecutivos y hasta cuándo está bloqueada la cuenta
  loginAttempts Int @default(0)
  lockedUntil DateTime?
  employeeDiscount Int @default(0) // % de descuento de trabajador (0-100)

 //Relations
 roleId String
 role Role @relation(fields: [roleId], references: [id])
 branchId String?
 branch Branch? @relation("StaffBranch", fields: [branchId], references: [id])
 // Sucursal favorita del cliente (para sus notificaciones); si la sucursal se elimina, queda sin favorita
 preferredBranchId String?
 preferredBranch Branch? @relation("PreferredBranch", fields: [preferredBranchId], references: [id], onDelete: SetNull)
 orders Order[]
 cashierOrders Order[] @relation("CashierOrders")
 // Devoluciones donde figura como cliente, y las que atendió como cajero
 returns Return[] @relation("CustomerReturns")
 cashierReturns Return[] @relation("CashierReturns")
 carts Cart[]
 payments Payment[]
 addresses UserAddress[]
 pushSubscriptions PushSubscription[]
 // Diseño de su dashboard de analítica en el panel (uno por usuario)
 dashboardLayout DashboardLayout?

 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

@@index([email])
@@index([branchId])
@@index([preferredBranchId])
@@index([roleId])
@@map("users")
} 

// Direcciones guardadas del cliente para envíos a domicilio (con la ubicación exacta del mapa)
model UserAddress {
  id        String   @id @default(uuid())
  title     String   // ej. "Casa", "Trabajo"
  address   String   // calle y número
  reference String?  // referencias adicionales
  latitude  Float
  longitude Float
  isDefault Boolean  @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("user_addresses")
}

model Product {
  id        String      @id @default(uuid())
  // name/description: texto en el idioma base de la tienda (español). Es lo que usan la búsqueda, los
  // reportes (vistas SQL), el POS, los pedidos y los correos; por eso no se reemplazó por JSONB.
  name      String
  description String?
  // Traducciones del catálogo (JSONB): { "en": { "name": "...", "description": "..." }, "fr": {...} }.
  // Claves: en, fr, pt, zh (el español es name/description). Un idioma o campo ausente cae al texto
  // base. La API devuelve name/description ya resueltos según Accept-Language (ver products.service).
  translations Json @default("{}")
  sizes String[] @default([])
  // Colores disponibles de la prenda. Mismo modelo que `sizes`: un array simple en el producto, no
  // una variante independiente. El stock sigue siendo por producto+sucursal (ProductInventory), no
  // por talla ni por color — ver nota de auditoría en el chat sobre por qué no se creó ProductVariant.
  colors String[] @default([])
  price     Decimal @db.Decimal(10, 2)
  // Agregado materializado (SUM de ProductInventory.stock), solo para mostrar: NUNCA autoriza una venta.
  // Lo recalcula InventoryService.syncGlobalStockMany con el producto bloqueado.
  stock     Int @default(0)
  sku String @unique
  imageUrl String?
  isActive Boolean @default(true)

  //Relations
  orderItems OrderItem[]
  cartItems CartItem[]
  inventories ProductInventory[]
  returnItems ReturnItem[]
  // Colecciones a las que pertenece (ej. "Otoño-Invierno", "Nueva Temporada"). Un producto puede
  // estar en varias; relación implícita m2m (Prisma crea la tabla puente sola)
  collections Collection[]

  categoryId String
  category Category @relation(fields: [categoryId], references: [id])

  // Exclusividad de sucursal: null = global (todas las sucursales lo ven); con valor, solo esa
  // sucursal lo ve en su catálogo. Independiente de ProductInventory: esto decide SI se ve, el
  // inventario decide CUÁNTO stock hay una vez que ya se ve.
  branchId String?
  exclusiveToBranch Branch? @relation(fields: [branchId], references: [id])

  //Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sku])
  @@index([categoryId])
  @@index([isActive])
  @@index([branchId])
  @@map("products")
}

model Branch {
  id        String      @id @default(uuid())
  name      String
  address   String?
  latitude  Float?
  longitude Float?
  phone     String?
  isActive  Boolean @default(true)

  //Relations
  users User[] @relation("StaffBranch")
  preferredByUsers User[] @relation("PreferredBranch")
  orders Order[]
  inventories ProductInventory[]
  exclusiveProducts Product[]
  cartReservations CartItem[]
  // Devoluciones recibidas en esta sucursal (su inventario es el que recibe la mercadería)
  returns Return[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("branches")
}

model ProductInventory {
  id        String      @id @default(uuid())
  // Stock por producto+sucursal+talla (antes era solo producto+sucursal). "size" siempre es una de
  // las tallas de Product.sizes: cada producto nace sin filas hasta que Inventario le asigna stock
  // talla por talla.
  size      String
  stock     Int @default(0)
  // Descuentos por sucursal: discountPrice tiene prioridad sobre discountPercentage. Se mantienen
  // iguales entre las tallas de un mismo producto+sucursal (la oferta no varía por talla); el
  // servicio se encarga de sincronizarlos entre filas.
  discountPrice Decimal? @db.Decimal(10, 2)
  discountPercentage Int?

  // Mermas: unidades de esta talla que volvieron por una devolución en mal estado. NO son vendibles y
  // por eso viven aparte de `stock` (y quedan fuera de Product.stock): existen físicamente en la
  // sucursal, pero solo para auditoría/baja, nunca para el catálogo ni la caja.
  damagedStock Int @default(0)

  // Concurrencia optimista de los ajustes (también offline): TODA mutación de stock/mermas la incrementa.
  // Un conteo basado en una versión vieja recibe conflicto en vez de resucitar unidades ya vendidas.
  version Int @default(1)

  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  branchId String
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, branchId, size])
  @@index([branchId])
  @@index([productId])
  @@map("product_inventories")
}

// Colección de temporada/campaña (ej. "Otoño-Invierno", "Básicos"). Independiente de Category:
// una categoría es "qué es" la prenda (vestido, blusa); una colección es "para qué campaña" se
// exhibe. Un producto puede estar en varias colecciones a la vez.
model Collection {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  description    String?
  bannerImageUrl String?
  isActive       Boolean  @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([isActive])
  @@map("collections")
}

model Category {
  id        String      @id @default(uuid())
  name      String
  description String?
  slug String @unique
  imageUrl String?
  isActive Boolean @default(true)
  //Relations
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([slug])
  @@index([isActive])
  @@map("categories")
}

model OrderItem {
  id        String      @id @default(uuid())
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
  // Talla elegida al comprar (independiente de `Product.sizes`, que son las tallas disponibles)
  size      String?
  productId String
  product Product @relation(fields: [productId], references: [id])

  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Devoluciones de esta línea: su suma es el tope que valida ReturnsService (nunca más de `quantity`)
  returnItems ReturnItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
 } 

model CartItem {
  id        String      @id @default(uuid())
  quantity  Int @default(1)
  // Talla elegida (una fila distinta por producto+talla)
  size      String?
  // Sucursal contra cuyo inventario se reservó (descontó) el stock de este ítem al agregarlo
  // (CartService.addItem). Null: se agregó sin sucursal elegida y la reserva fue contra el stock
  // global legado (Product.stock). Se usa para saber a quién devolver el stock al quitar el ítem,
  // vaciar el carrito o liberarlo por abandono (CartCleanupService) — no tiene por qué coincidir
  // con la sucursal que el usuario tenga seleccionada más tarde.
  branchId  String?
  branch    Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  productId String
  product Product @relation(fields: [productId], references: [id])

  cartId String
  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  reservation StockReservation?

  @@unique([cartId, productId, size])
  @@index([cartId])
  @@index([productId])
  @@index([branchId])
  @@map("cart_items")

}

enum OrderStatus {
  PENDIENTE
  PROCESANDO
  ENVIADO
  ENTREGADO
  CANCELADO
}


enum FulfillmentType {
  DELIVERY
  PICKUP
}

// Canal de venta: WEB (e-commerce, cliente final) o POS (caja física de una sucursal)
enum OrderSource {
  WEB
  POS
}

enum PaymentMethod {
  STRIPE
  CASH
  PHYSICAL_CARD
  // QR simulado (demo): se confirma solo al escanearlo
  QR
  // QR bancario real de la tienda: el cliente sube el comprobante y la tienda lo aprueba a mano
  BANK_QR
  // Transferencia USDT a la wallet de la tienda: el cliente informa el TxID y la tienda lo verifica
  USDT
  // Billetera digital P2P (Airtm, Takenos, Wallbit)
  WALLET
}

enum UsdtNetwork {
  TRC20
  ERC20
  BEP20
  POLYGON
}

enum PaymentProofStatus {
  PENDIENTE
  APROBADO
  RECHAZADO
}

// Medios de cobro manuales de la tienda (una sola fila, id "default"). La cuenta de Stripe Connect
// NO está acá: vive en public.tenants porque el webhook la necesita antes de abrir este schema.
model PaymentSettings {
  id String @id @default("default")

  qrEnabled Boolean @default(false)
  // Imagen del QR bancario (máx. ~2 MB); se sirve desde la API, nunca se lista junto al resto
  qrImage Bytes?
  qrImageType String?
  qrInstructions String?

  usdtEnabled Boolean @default(false)
  usdtNetwork UsdtNetwork?
  usdtWalletAddress String?

  walletEnabled Boolean @default(false)
  walletProvider String?
  walletAccount String?
  walletInstructions String?

  updatedAt DateTime @updatedAt

  @@map("payment_settings")
}

// Apariencia pública de la tienda (una sola fila, id "default"): la lee el layout de la vitrina en cada
// render (cacheado en el front), así que va sin relaciones. logoUrl/faviconUrl guardan una URL externa
// https o un data URL de la imagen subida desde el panel (el <img> público no puede mandar x-tenant-id).
model StoreAppearance {
  id String @id @default("default")

  logoUrl String?
  faviconUrl String?
  primaryColor String @default("#000000")
  secondaryColor String @default("#ffffff")
  // SEO (<meta name="description">) y la sección "Quiénes somos"
  description String?
  // [{ platform: "instagram", url: "https://..." }] (ver SOCIAL_PLATFORMS en el módulo appearance)
  socialLinks Json?

  // Tipografía de toda la tienda: uno de FONT_FAMILIES (el front la mapea a next/font)
  fontFamily String @default("Inter")
  navbarBackgroundColor String @default("#ffffff")
  navbarTextColor String @default("#000000")
  searchBarBackgroundColor String @default("#333333")
  storeBackgroundColor String @default("#ffffff")
  // URL externa https o data URL (igual que el logo); el front la sirve desde /store-assets/background
  storeBackgroundImage String?
  // Menú lateral del panel de la propia tienda
  adminMenuColor String @default("#1a1a1a")

  updatedAt DateTime @updatedAt

  @@map("store_appearance")
}

// Comprobante de un pago manual (BANK_QR o USDT). Tabla aparte para que los listados de pedidos no
// carguen la imagen. Mientras está PENDIENTE el stock del pedido sigue reservado.
model PaymentProof {
  id String @id @default(uuid())
  orderId String @unique
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  method PaymentMethod
  image Bytes?
  imageType String?
  txId String?
  status PaymentProofStatus @default(PENDIENTE)

  reviewedById String?
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("payment_proofs")
}

model Order {
  id        String      @id @default(uuid())
  orderNumber String @unique @default(cuid())
  status OrderStatus @default(PENDIENTE)
  totalAmount Decimal @db.Decimal(10, 2)
  // Costo de envío ya incluido en totalAmount; queda aparte como registro histórico exacto (0 en PICKUP)
  shippingCost Decimal @default(0) @db.Decimal(10, 2)
  // Estado del pago con Stripe, separado del estado de logística (OrderStatus)
  paymentStatus PaymentStatus @default(PENDIENTE)
  stripePaymentIntentId String? @unique
  // Cómo se pagó: STRIPE (web) o CASH/PHYSICAL_CARD (venta física en caja)
  paymentMethod PaymentMethod @default(STRIPE)
  // Canal por el que se originó la venta
  source OrderSource @default(WEB)

  userId    String
  //Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Empleado que cobró la venta en caja (POS). Null en ventas web
  cashierId String?
  cashier User? @relation("CashierOrders", fields: [cashierId], references: [id])

  cartId String?
  cart Cart? @relation(fields: [cartId], references: [id])

  shippingAddress String?
  // Ubicación exacta de entrega (solo pedidos DELIVERY)
  latitude Float?
  longitude Float?
  fulfillmentType FulfillmentType @default(DELIVERY)
  discountApplied Decimal @default(0) @db.Decimal(10, 2)

  // Vencimiento del pago pendiente (reloj del servidor, política por método en checkout-policy.ts)
  paymentExpiresAt DateTime?
  // Intención de cancelar persistida ANTES de hablar con el proveedor: un barrido la retoma tras un crash
  cancelRequestedAt DateTime?
  // Estado de conciliación financiera, aparte de la logística: null | LATE_PAYMENT | MANUAL_REVIEW
  reconciliationStatus String?

  // Datos de facturación (venta física en POS). Null en ventas web o cuando el cliente no los pide
  nit String?
  razonSocial String?

  branchId String?
  branch Branch? @relation(fields: [branchId], references: [id])

  orderItems OrderItem[]
  payment Payment?
  paymentProof PaymentProof?
  // Devoluciones procesadas contra esta venta (puede haber varias, parciales)
  returns Return[]
  checkoutAttempt CheckoutAttempt?
  paymentAttempts PaymentAttempt[]
  reservations StockReservation[]
  compensations PaymentCompensation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([paymentStatus])
  @@index([branchId])
  @@index([cashierId])
  @@index([source])
  @@index([status, paymentExpiresAt])
  @@map("orders")
}

model Cart {
  id        String      @id @default(uuid())
  userId    String
  //Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  checkout Boolean @default(false)

  // Único carrito activo por usuario. Null en carritos cerrados o en duplicados heredados que barre el cron.
  activeUserId String? @unique
  // Revisión: sube con cada cambio. Un checkout consume una revisión una sola vez.
  version Int @default(1)

  cartItems CartItem[]
  reservations StockReservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("carts")

}

enum PaymentStatus {
  PENDIENTE
  COMPLETADO
  FALLIDO
  REEMBOLSADO
}

// Por qué el cliente devolvió la prenda. Es el motivo declarado en mostrador y es independiente del
// estado físico (ItemCondition): alguien puede devolver por talla equivocada una prenda que llega
// dañada, y lo que decide si vuelve a venderse es la condición, no el motivo.
enum ReturnReason {
  WRONG_SIZE
  DEFECTIVE
  CHANGED_MIND
  OTHER
}

// Estado físico con el que la prenda vuelve a la sucursal, y lo único que decide a qué inventario entra:
// SELLABLE suma al stock vendible (ProductInventory.stock), DAMAGED suma a las mermas (damagedStock).
enum ItemCondition {
  SELLABLE
  DAMAGED
}

// Devolución física procesada en mostrador contra una venta previa (web o POS: ambas son Order).
// La sucursal es la que RECIBE la mercadería (donde está parado el cliente), que no siempre es la
// misma que vendió: un pedido web se puede devolver en cualquier tienda, y el stock tiene que
// aparecer donde la prenda quedó físicamente.
model Return {
  id           String  @id @default(uuid())
  returnNumber String  @unique @default(cuid())
  // Suma de los reembolsos de sus líneas, calculada siempre en el servidor desde el precio histórico
  // de cada OrderItem (nunca desde lo que manda el cliente)
  totalRefunded Decimal @db.Decimal(10, 2)
  notes        String?

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  // Cliente dueño de la orden original
  userId String
  user   User   @relation("CustomerReturns", fields: [userId], references: [id])

  // Empleado que atendió la devolución en caja
  cashierId String
  cashier   User   @relation("CashierReturns", fields: [cashierId], references: [id])

  items ReturnItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([branchId])
  @@index([userId])
  @@index([cashierId])
  @@index([createdAt])
  @@map("returns")
}

// Una línea devuelta. Apunta al OrderItem exacto (no solo al producto) porque es lo que permite
// validar el tope: nunca se puede devolver más de lo que esa línea vendió, sumando devoluciones
// anteriores. Una misma línea puede generar varias filas: 2 unidades de vuelta con 1 vendible y 1
// dañada son dos ReturnItem con distinta `condition`.
model ReturnItem {
  id        String  @id @default(uuid())
  quantity  Int
  // Talla devuelta: se copia del OrderItem (es la que se vendió), no se acepta del cliente
  size      String?
  // Precio unitario histórico al que se vendió, copiado del OrderItem para poder auditar el reembolso
  // aunque después cambie el precio del producto o su oferta
  unitPrice Decimal @db.Decimal(10, 2)
  reason    ReturnReason
  condition ItemCondition

  returnId String
  return   Return @relation(fields: [returnId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([returnId])
  @@index([productId])
  @@index([orderItemId])
  @@index([condition])
  @@map("return_items")
}

// Lienzo del dashboard de analítica (/admin/reports/dashboard) de cada usuario del panel.
// widgetsConfig: [{ i, x, y, w, h, type, metric }] — posición y tamaño en unidades de la grilla de 12
// columnas, tipo de gráfico y métrica que muestra (ver WIDGET_TYPES / WIDGET_METRICS en el módulo analytics).
model DashboardLayout {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  widgetsConfig Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("dashboard_layouts")
}

// Suscripción Web Push de un navegador/dispositivo. Un usuario puede tener varias (uno por dispositivo)
model PushSubscription {
  id       String @id @default(uuid())
  endpoint String @unique
  p256dh   String
  auth     String

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("push_subscriptions")
}

model Payment {
  id        String      @id @default(uuid())
  amount Decimal @db.Decimal(10, 2)
  status PaymentStatus @default(PENDIENTE)
  currency String @default("USD")
  paymentMethod String?
  transactionId String?

  userId    String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  orderId String @unique
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([userId])
  @@index([transactionId])
  @@map("payments")
}

// ─── Compra resistente a fallos ─────────────────────────────────────────────────────────────────
// Ecuación del inventario: ProductInventory.stock = unidades disponibles. Las reservas ACTIVE y las
// CONSUMED de pedidos vivos YA están descontadas de stock; no hay un contador "reservado" aparte.

enum ReservationStatus {
  ACTIVE // retenida por una línea de carrito
  CONSUMED // transferida a una orden: mismo descuento, otro propietario
  RELEASED // devuelta al stock (quitar del carrito, cancelar la orden)
  EXPIRED // devuelta al stock por vencimiento
}

model StockReservation {
  id       String @id @default(uuid())
  status   ReservationStatus @default(ACTIVE)
  quantity Int
  // Sube con cada cambio de cantidad: forma parte del identificador de efecto de sus movimientos
  revision Int @default(0)
  expiresAt DateTime?

  userId    String
  productId String
  branchId  String
  size      String

  // Propietario: una línea de carrito (ACTIVE) o una orden (CONSUMED)
  cartId     String?
  cart       Cart?   @relation(fields: [cartId], references: [id], onDelete: SetNull)
  cartItemId String? @unique
  cartItem   CartItem? @relation(fields: [cartItemId], references: [id], onDelete: SetNull)
  orderId    String?
  order      Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, expiresAt])
  @@index([cartId])
  @@index([orderId])
  @@map("stock_reservations")
}

// Libro de movimientos. effectId es único: aplicar dos veces el mismo efecto es imposible aunque se
// reintente (doble cancelación, cron duplicado, webhook repetido).
model InventoryMovement {
  id           String @id @default(uuid())
  effectId     String @unique
  productId    String
  branchId     String
  size         String
  stockDelta   Int @default(0)
  damagedDelta Int @default(0)
  reason       String
  refType      String?
  refId        String?
  createdAt    DateTime @default(now())

  @@index([productId, branchId, size])
  @@index([refType, refId])
  @@map("inventory_movements")
}

enum CheckoutAttemptStatus {
  IN_PROGRESS
  SUCCEEDED
  REJECTED
}

// Intento lógico de compra (Idempotency-Key). Se conserva aunque se purgue cualquier caché: es lo que
// impide que un reintento vuelva a comprar. Índice parcial en la migración: una revisión de carrito
// solo se consume una vez, incluso con claves distintas.
model CheckoutAttempt {
  id          String @id @default(uuid())
  userId      String
  operation   String
  key         String
  payloadHash String
  status      CheckoutAttemptStatus @default(IN_PROGRESS)
  cartId      String?
  cartVersion Int?
  orderId     String? @unique
  order       Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  resultCode  String?
  resultMessage String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, operation, key])
  @@map("checkout_attempts")
}

enum PaymentAttemptStatus {
  CREATED // persistido, todavía sin respuesta del proveedor
  OPEN // el proveedor devolvió un PaymentIntent
  SUCCEEDED
  CANCELED
  ABANDONED // sin PaymentIntent y fuera del horizonte de idempotencia del proveedor
}

// Intento durable de cobro: se persiste con sus parámetros económicos inmutables ANTES de llamar a
// Stripe. Índice parcial en la migración: una orden tiene como máximo un intento abierto.
model PaymentAttempt {
  id             String @id @default(uuid())
  orderId        String
  order          Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId         String
  attemptNumber  Int
  provider       String @default("STRIPE")
  status         PaymentAttemptStatus @default(CREATED)
  providerStatus String?
  amountMinor    Int
  currency       String
  destinationAccount String?
  feeAmountMinor Int?
  idempotencyKey String @unique
  stripePaymentIntentId String? @unique
  livemode       Boolean?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([orderId, attemptNumber])
  @@index([status, updatedAt])
  @@map("payment_attempts")
}

enum CompensationStatus {
  REQUESTED // persistida, falta llamar al proveedor
  REFUND_PENDING // reembolso solicitado, sin confirmación
  REFUNDED // el proveedor confirmó el reembolso
  MANUAL_REVIEW // requiere gestión humana
}

// Cobro que no puede cumplirse (pago tardío de una orden ya liberada, segundo cobro). Reponer inventario
// no equivale a devolver dinero: aquí se distingue reembolso solicitado de completado.
model PaymentCompensation {
  id        String @id @default(uuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentIntentId String @unique
  reason    String
  status    CompensationStatus @default(REQUESTED)
  amountMinor Int
  currency  String
  refundId  String?
  attempts  Int @default(0)
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("payment_compensations")
}

enum OutboxStatus {
  PENDING
  DONE
  DEAD
}

// Efectos externos (correo, factura, push) confirmados junto con la transición que los origina y
// entregados por un consumidor reintentable. Entrega al menos una vez: el proveedor externo no deduplica.
model OutboxEvent {
  id        String @id @default(uuid())
  type      String
  dedupeKey String @unique
  payload   Json
  status    OutboxStatus @default(PENDING)
  attempts  Int @default(0)
  nextAttemptAt DateTime @default(now())
  leaseUntil DateTime?
  lastError String?
  createdAt DateTime @default(now())
  processedAt DateTime?

  @@index([status, nextAttemptAt])
  @@map("outbox_events")
}

// Anomalías para operación: datos heredados inconsistentes, PaymentIntent rechazado, pago por conciliar...
model OperationalIssue {
  id        String @id @default(uuid())
  type      String
  severity  String @default("WARN")
  dedupeKey String? @unique
  details   Json
  createdAt DateTime @default(now())
  resolvedAt DateTime?

  @@index([type, resolvedAt])
  @@map("operational_issues")
}
