generator client {
  provider = "prisma-client-js"
 // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//Create.Database.Schemas
//User.model
// Roles dinámicos: el SUPERADMIN los crea desde el panel y cada uno lleva sus permisos
model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions String[] @default([])

  //Relations
  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model User {
  id        String      @id @default(uuid())
  email     String   @unique
  password  String
  firstName      String?
  lastName       String?
  phone          String?
  refreshToken String?
  // Recuperación de contraseña: código (OTP) de 6 dígitos como texto (puede empezar con 0), su vencimiento y los intentos fallidos
  resetPasswordOtp String?
  resetPasswordAttempts Int @default(0)
  resetPasswordExpires DateTime?
  // Bloqueo de login: intentos fallidos consecutivos y hasta cuándo está bloqueada la cuenta
  loginAttempts Int @default(0)
  lockedUntil DateTime?
  employeeDiscount Int @default(0) // % de descuento de trabajador (0-100)

 //Relations
 roleId String
 role Role @relation(fields: [roleId], references: [id])
 branchId String?
 branch Branch? @relation("StaffBranch", fields: [branchId], references: [id])
 // Sucursal favorita del cliente (para sus notificaciones); si la sucursal se elimina, queda sin favorita
 preferredBranchId String?
 preferredBranch Branch? @relation("PreferredBranch", fields: [preferredBranchId], references: [id], onDelete: SetNull)
 orders Order[]
 cashierOrders Order[] @relation("CashierOrders")
 // Devoluciones donde figura como cliente, y las que atendió como cajero
 returns Return[] @relation("CustomerReturns")
 cashierReturns Return[] @relation("CashierReturns")
 carts Cart[]
 payments Payment[]
 addresses UserAddress[]
 pushSubscriptions PushSubscription[]

 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

@@index([email])
@@index([branchId])
@@index([preferredBranchId])
@@index([roleId])
@@map("users")
} 

// Direcciones guardadas del cliente para envíos a domicilio (con la ubicación exacta del mapa)
model UserAddress {
  id        String   @id @default(uuid())
  title     String   // ej. "Casa", "Trabajo"
  address   String   // calle y número
  reference String?  // referencias adicionales
  latitude  Float
  longitude Float
  isDefault Boolean  @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("user_addresses")
}

model Product {
  id        String      @id @default(uuid())
  name      String
  description String?
  sizes String[] @default([])
  // Colores disponibles de la prenda. Mismo modelo que `sizes`: un array simple en el producto, no
  // una variante independiente. El stock sigue siendo por producto+sucursal (ProductInventory), no
  // por talla ni por color — ver nota de auditoría en el chat sobre por qué no se creó ProductVariant.
  colors String[] @default([])
  price     Decimal @db.Decimal(10, 2)
  stock     Int @default(0) // stock global (legado); el stock por sucursal está en ProductInventory
  sku String @unique
  imageUrl String?
  isActive Boolean @default(true)

  //Relations
  orderItems OrderItem[]
  cartItems CartItem[]
  inventories ProductInventory[]
  returnItems ReturnItem[]
  // Colecciones a las que pertenece (ej. "Otoño-Invierno", "Nueva Temporada"). Un producto puede
  // estar en varias; relación implícita m2m (Prisma crea la tabla puente sola)
  collections Collection[]

  categoryId String
  category Category @relation(fields: [categoryId], references: [id])

  // Exclusividad de sucursal: null = global (todas las sucursales lo ven); con valor, solo esa
  // sucursal lo ve en su catálogo. Independiente de ProductInventory: esto decide SI se ve, el
  // inventario decide CUÁNTO stock hay una vez que ya se ve.
  branchId String?
  exclusiveToBranch Branch? @relation(fields: [branchId], references: [id])

  //Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sku])
  @@index([categoryId])
  @@index([isActive])
  @@index([branchId])
  @@map("products")
}

model Branch {
  id        String      @id @default(uuid())
  name      String
  address   String?
  latitude  Float?
  longitude Float?
  phone     String?
  isActive  Boolean @default(true)

  //Relations
  users User[] @relation("StaffBranch")
  preferredByUsers User[] @relation("PreferredBranch")
  orders Order[]
  inventories ProductInventory[]
  exclusiveProducts Product[]
  cartReservations CartItem[]
  // Devoluciones recibidas en esta sucursal (su inventario es el que recibe la mercadería)
  returns Return[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("branches")
}

model ProductInventory {
  id        String      @id @default(uuid())
  // Stock por producto+sucursal+talla (antes era solo producto+sucursal). "size" siempre es una de
  // las tallas de Product.sizes: cada producto nace sin filas hasta que Inventario le asigna stock
  // talla por talla.
  size      String
  stock     Int @default(0)
  // Descuentos por sucursal: discountPrice tiene prioridad sobre discountPercentage. Se mantienen
  // iguales entre las tallas de un mismo producto+sucursal (la oferta no varía por talla); el
  // servicio se encarga de sincronizarlos entre filas.
  discountPrice Decimal? @db.Decimal(10, 2)
  discountPercentage Int?

  // Mermas: unidades de esta talla que volvieron por una devolución en mal estado. NO son vendibles y
  // por eso viven aparte de `stock` (y quedan fuera de Product.stock): existen físicamente en la
  // sucursal, pero solo para auditoría/baja, nunca para el catálogo ni la caja.
  damagedStock Int @default(0)

  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  branchId String
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, branchId, size])
  @@index([branchId])
  @@index([productId])
  @@map("product_inventories")
}

// Colección de temporada/campaña (ej. "Otoño-Invierno", "Básicos"). Independiente de Category:
// una categoría es "qué es" la prenda (vestido, blusa); una colección es "para qué campaña" se
// exhibe. Un producto puede estar en varias colecciones a la vez.
model Collection {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  description    String?
  bannerImageUrl String?
  isActive       Boolean  @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([isActive])
  @@map("collections")
}

model Category {
  id        String      @id @default(uuid())
  name      String
  description String?
  slug String @unique
  imageUrl String?
  isActive Boolean @default(true)
  //Relations
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([slug])
  @@index([isActive])
  @@map("categories")
}

model OrderItem {
  id        String      @id @default(uuid())
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
  // Talla elegida al comprar (independiente de `Product.sizes`, que son las tallas disponibles)
  size      String?
  productId String
  product Product @relation(fields: [productId], references: [id])

  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Devoluciones de esta línea: su suma es el tope que valida ReturnsService (nunca más de `quantity`)
  returnItems ReturnItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
 } 

model CartItem {
  id        String      @id @default(uuid())
  quantity  Int @default(1)
  // Talla elegida (una fila distinta por producto+talla)
  size      String?
  // Sucursal contra cuyo inventario se reservó (descontó) el stock de este ítem al agregarlo
  // (CartService.addItem). Null: se agregó sin sucursal elegida y la reserva fue contra el stock
  // global legado (Product.stock). Se usa para saber a quién devolver el stock al quitar el ítem,
  // vaciar el carrito o liberarlo por abandono (CartCleanupService) — no tiene por qué coincidir
  // con la sucursal que el usuario tenga seleccionada más tarde.
  branchId  String?
  branch    Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  productId String
  product Product @relation(fields: [productId], references: [id])

  cartId String
  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, size])
  @@index([cartId])
  @@index([productId])
  @@index([branchId])
  @@map("cart_items")

}

enum OrderStatus {
  PENDIENTE
  PROCESANDO
  ENVIADO
  ENTREGADO
  CANCELADO
}


enum FulfillmentType {
  DELIVERY
  PICKUP
}

// Canal de venta: WEB (e-commerce, cliente final) o POS (caja física de una sucursal)
enum OrderSource {
  WEB
  POS
}

enum PaymentMethod {
  STRIPE
  CASH
  PHYSICAL_CARD
  QR
}

model Order {
  id        String      @id @default(uuid())
  orderNumber String @unique @default(cuid())
  status OrderStatus @default(PENDIENTE)
  totalAmount Decimal @db.Decimal(10, 2)
  // Costo de envío ya incluido en totalAmount; queda aparte como registro histórico exacto (0 en PICKUP)
  shippingCost Decimal @default(0) @db.Decimal(10, 2)
  // Estado del pago con Stripe, separado del estado de logística (OrderStatus)
  paymentStatus PaymentStatus @default(PENDIENTE)
  stripePaymentIntentId String? @unique
  // Cómo se pagó: STRIPE (web) o CASH/PHYSICAL_CARD (venta física en caja)
  paymentMethod PaymentMethod @default(STRIPE)
  // Canal por el que se originó la venta
  source OrderSource @default(WEB)

  userId    String
  //Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Empleado que cobró la venta en caja (POS). Null en ventas web
  cashierId String?
  cashier User? @relation("CashierOrders", fields: [cashierId], references: [id])

  cartId String?
  cart Cart? @relation(fields: [cartId], references: [id])

  shippingAddress String?
  // Ubicación exacta de entrega (solo pedidos DELIVERY)
  latitude Float?
  longitude Float?
  fulfillmentType FulfillmentType @default(DELIVERY)
  discountApplied Decimal @default(0) @db.Decimal(10, 2)

  // Datos de facturación (venta física en POS). Null en ventas web o cuando el cliente no los pide
  nit String?
  razonSocial String?

  branchId String?
  branch Branch? @relation(fields: [branchId], references: [id])

  orderItems OrderItem[]
  payment Payment?
  // Devoluciones procesadas contra esta venta (puede haber varias, parciales)
  returns Return[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([paymentStatus])
  @@index([branchId])
  @@index([cashierId])
  @@index([source])
  @@map("orders")
}

model Cart {
  id        String      @id @default(uuid())
  userId    String
  //Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  checkout Boolean @default(false)

  cartItems CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("carts")

}

enum PaymentStatus {
  PENDIENTE
  COMPLETADO
  FALLIDO
  REEMBOLSADO
}

// Por qué el cliente devolvió la prenda. Es el motivo declarado en mostrador y es independiente del
// estado físico (ItemCondition): alguien puede devolver por talla equivocada una prenda que llega
// dañada, y lo que decide si vuelve a venderse es la condición, no el motivo.
enum ReturnReason {
  WRONG_SIZE
  DEFECTIVE
  CHANGED_MIND
  OTHER
}

// Estado físico con el que la prenda vuelve a la sucursal, y lo único que decide a qué inventario entra:
// SELLABLE suma al stock vendible (ProductInventory.stock), DAMAGED suma a las mermas (damagedStock).
enum ItemCondition {
  SELLABLE
  DAMAGED
}

// Devolución física procesada en mostrador contra una venta previa (web o POS: ambas son Order).
// La sucursal es la que RECIBE la mercadería (donde está parado el cliente), que no siempre es la
// misma que vendió: un pedido web se puede devolver en cualquier tienda, y el stock tiene que
// aparecer donde la prenda quedó físicamente.
model Return {
  id           String  @id @default(uuid())
  returnNumber String  @unique @default(cuid())
  // Suma de los reembolsos de sus líneas, calculada siempre en el servidor desde el precio histórico
  // de cada OrderItem (nunca desde lo que manda el cliente)
  totalRefunded Decimal @db.Decimal(10, 2)
  notes        String?

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  // Cliente dueño de la orden original
  userId String
  user   User   @relation("CustomerReturns", fields: [userId], references: [id])

  // Empleado que atendió la devolución en caja
  cashierId String
  cashier   User   @relation("CashierReturns", fields: [cashierId], references: [id])

  items ReturnItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([branchId])
  @@index([userId])
  @@index([cashierId])
  @@index([createdAt])
  @@map("returns")
}

// Una línea devuelta. Apunta al OrderItem exacto (no solo al producto) porque es lo que permite
// validar el tope: nunca se puede devolver más de lo que esa línea vendió, sumando devoluciones
// anteriores. Una misma línea puede generar varias filas: 2 unidades de vuelta con 1 vendible y 1
// dañada son dos ReturnItem con distinta `condition`.
model ReturnItem {
  id        String  @id @default(uuid())
  quantity  Int
  // Talla devuelta: se copia del OrderItem (es la que se vendió), no se acepta del cliente
  size      String?
  // Precio unitario histórico al que se vendió, copiado del OrderItem para poder auditar el reembolso
  // aunque después cambie el precio del producto o su oferta
  unitPrice Decimal @db.Decimal(10, 2)
  reason    ReturnReason
  condition ItemCondition

  returnId String
  return   Return @relation(fields: [returnId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([returnId])
  @@index([productId])
  @@index([orderItemId])
  @@index([condition])
  @@map("return_items")
}

// Suscripción Web Push de un navegador/dispositivo. Un usuario puede tener varias (uno por dispositivo)
model PushSubscription {
  id       String @id @default(uuid())
  endpoint String @unique
  p256dh   String
  auth     String

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("push_subscriptions")
}

model Payment {
  id        String      @id @default(uuid())
  amount Decimal @db.Decimal(10, 2)
  status PaymentStatus @default(PENDIENTE)
  currency String @default("USD")
  paymentMethod String?
  transactionId String?

  userId    String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  orderId String @unique
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([userId])
  @@index([transactionId])
  @@map("payments")
}