# Servidor
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# Base de datos (PostgreSQL)
DATABASE_URL=postgresql://USUARIO:CONTRASENA@localhost:5432/NOMBRE_BD

# JWT
JWT_SECRET=cambia_este_secreto
JWT_REFRESH_SECRET=cambia_este_otro_secreto
JWT_EXPIRES_IN=900

# Stripe (clave secreta, la que empieza con sk_)
STRIPE_SECRET_KEY=sk_test_xxx
# Firma del webhook de Stripe (whsec_...). Con el Stripe CLI: stripe listen --forward-to localhost:3001/api/v1/payments/webhook
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Planes del SaaS (Prices recurrentes de Stripe, price_...). Los montos deben coincidir con
# front/components/modules/platform/plans.ts. Sin estos, el checkout de ese plan responde 503.
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_GROWTH=price_xxx
STRIPE_PRICE_PRO=price_xxx

# Correo (SMTP). Si SMTP_HOST está vacío no se envían correos reales: se registran en consola (modo desarrollo)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Stella Femme <no-reply@stellafemme.com>"
# Bandeja que recibe el formulario de contacto de la landing (POST /api/v1/platform/contact)
SUPPORT_EMAIL=soporte@stellafemme.com

# Compra resistente a fallos (todos opcionales; valores por defecto en src/common/checkout/checkout-policy.ts)
# Moneda de cobro con tarjeta: la fija el servidor, nunca el cliente. Debe ser la de los precios (Bs = bob):
# el checkout no ofrece tarjeta si no coincide
PAYMENT_CURRENCY=bob
# Reserva de carrito sin actividad (1 h)
CART_RESERVATION_TTL_MS=3600000
# Plazo para pagar: tarjeta/QR (1 h) y medios manuales sin comprobante (24 h)
ORDER_TTL_CARD_MS=3600000
ORDER_TTL_MANUAL_MS=86400000
# Reserva que se conserva si el proveedor responde "processing" o no responde (6 h, renovable)
PAYMENT_RECONCILIATION_HOLD_MS=21600000
# QR simulado y confirmación con tarjeta de prueba. Ignorado con NODE_ENV=production o sin clave sk_test_
ALLOW_SIMULATED_PAYMENTS=false
# Solo para réplicas sin trabajos en segundo plano
DISABLE_BACKGROUND_JOBS=false

# URL del frontend (para los enlaces de los correos)
FRONTEND_URL=http://localhost:3000
# URL de la landing del SaaS (success/cancel de Stripe Checkout y enlace del correo de bienvenida).
# Si se omite, se usa FRONTEND_URL.
PLATFORM_URL=http://localhost:3000

# IA para reportes dinámicos (Groq, SDK compatible con OpenAI). Clave en https://console.groq.com/keys
GROQ_API_KEY=
# Modelo (opcional). Por defecto openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b

# Web Push (notificaciones). Genera un par con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@stellafemme.com

# --- Canal móvil (app oficial, solo tiendas Pro/Legacy) ------------------------------------------
# Sin configuración válida de una plataforma, esa plataforma NO puede abrir sesión móvil (503).
# Android — Play Integrity (standard request). Cuenta de servicio del proyecto de Google Cloud
# vinculado a la app en Play Console, con la API "Google Play Integrity" habilitada. JSON completo o base64.
PLAY_INTEGRITY_PACKAGE_NAME=
PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON=
# SHA-256 del certificado de Play App Signing (base64url, separados por coma). Obligatorio en producción.
PLAY_INTEGRITY_CERT_SHA256=
# MEETS_BASIC_INTEGRITY | MEETS_DEVICE_INTEGRITY (default) | MEETS_STRONG_INTEGRITY
PLAY_INTEGRITY_MIN_DEVICE_VERDICT=MEETS_DEVICE_INTEGRITY
PLAY_INTEGRITY_REQUIRE_LICENSED=false
# iOS — App Attest. "<TEAM_ID>.<bundle id>" y el PEM de "Apple App Attestation Root CA" (descargado de Apple)
APP_ATTEST_APP_ID=
APP_ATTEST_ROOT_CA_PEM=
# Acepta claves de builds de desarrollo (aaguid appattestdevelop). Ignorado con NODE_ENV=production.
APP_ATTEST_ALLOW_DEVELOPMENT=false
# Vida del desafío (5 min) y cada cuánto el refresh exige una prueba nueva (24 h)
MOBILE_ATTESTATION_CHALLENGE_TTL_MS=300000
MOBILE_REATTEST_AFTER_MS=86400000
# Atajo SIN verificación real: solo se respeta con NODE_ENV=development o test. Nunca en producción.
MOBILE_ATTESTATION_DEV_BYPASS=false

# Probador virtual (Decart), opcional: clave global (dct_...) para las tiendas con el probador en su plan
# que no tengan clave propia cargada desde /plataforma. Todo su consumo se cobra en esta cuenta.
DECART_API_KEY=
